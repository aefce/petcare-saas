  BackgroundColor<<Terminal>>  #EAEAEA
  BackgroundColor<<Exception>> #FDF2F2
  BorderColor<<Exception>>     #E02424
  BackgroundColor<<SOP>>       #F0F9FF
  BorderColor<<SOP>>           #0369A1
